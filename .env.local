# ======================================
# RemoteAdminTool — Environment Config
# ======================================
# These values are used by all 3 projects.

# ---- Relay Server ----
RAT_PORT=5050
RAT_TLS=false

# ---- Super Admin (Platform Owner — YOU) ----
# Enter this as the Admin Token in the Viewer with NO License Key.
RAT_SUPER_ADMIN_TOKEN=f7941a09575e414dbf96b253

# ---- Host Token ----
# Baked into every installer. All hosts across all tenants use this same token.
RAT_HOST_TOKEN=d6a6ac2563a8443ea686346c

# ---- MySQL (relay server database) ----
RAT_MYSQL_CONNECTION=server=localhost;port=3306;database=remote_admin;user=root;password=;

# ---- Sub-Admin Setup (set AFTER creating via super admin panel) ----
# For each sub-admin, you get back:
#   TenantId    — internal ID
#   LicenseKey  — goes in Host/appsettings.json for that sub-admin's installer
#   AdminToken  — given to the sub-admin to log into the Viewer app

# Example (replace with real values from the Create Tenant dialog):
# TENANT_1_ID=
# TENANT_1_LICENSE_KEY=
# TENANT_1_ADMIN_TOKEN=

# ---- Dev machine local test ----
# To test locally: set the Host's LicenseKey to the first tenant's LicenseKey
# and use the super admin token in the Viewer (with blank License Key field).