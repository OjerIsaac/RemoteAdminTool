# ======================================
# RemoteAdminTool — Environment Config
# ======================================
# These values are used by all 3 projects.

# ---- Shared Auth Tokens ----
# These MUST match between RelayServer and Host/Viewer
RAT_ADMIN_TOKEN=f7941a09575e414dbf96b253
RAT_HOST_TOKEN=d6a6ac2563a8443ea686346c

# ---- Relay Server ----
RAT_PORT=5050
RAT_TLS=false
RAT_CERT_PATH=
RAT_CERT_PASSWORD=dev-password

# ---- Host Agent ----
# Machine ID (stable across restarts — don't change once set)
RAT_MachineId=076e49fcac67
# Leave empty to auto-detect from hostname
RAT_MachineName=
# Set to true for headless/server deployments (skips consent dialog)
RAT_UnattendedMode=false
