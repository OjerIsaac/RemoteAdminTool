<Window x:Class="RemoteAdminTool.Viewer.CreateTenantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Sub-Admin" Height="360" Width="520" MinHeight="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#1e1e2e">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Create New Sub-Admin Tenant"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#cba6f7" Margin="0,0,0,24"/>

        <!-- Display Name -->
        <TextBlock Grid.Row="1" Text="Display Name"
                   Foreground="#a6adc8" FontSize="12" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" x:Name="DisplayNameBox"
                 Background="#313244" Foreground="#cdd6f4"
                 BorderBrush="#45475a" Padding="10,8" FontSize="14"
                 Margin="0,0,0,16"/>

        <!-- Admin Email -->
        <TextBlock Grid.Row="3" Text="Admin Email"
                   Foreground="#a6adc8" FontSize="12" Margin="0,0,0,6"/>
        <TextBox Grid.Row="4" x:Name="AdminEmailBox"
                 Background="#313244" Foreground="#cdd6f4"
                 BorderBrush="#45475a" Padding="10,8" FontSize="14"
                 Margin="0,0,0,0"/>

        <!-- Spacer -->
        <Grid Grid.Row="5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Click="CancelButton_Click"
                    Background="#45475a" Foreground="#cdd6f4"
                    BorderThickness="0" Padding="20,10" Margin="0,0,12,0"
                    Cursor="Hand" FontSize="13"/>
            <Button Content="✔  Create Tenant" Click="CreateButton_Click"
                    Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="Bold"
                    BorderThickness="0" Padding="20,10"
                    Cursor="Hand" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
