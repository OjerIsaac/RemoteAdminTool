<Window x:Class="RemoteAdminTool.Viewer.TenantCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Credentials" Height="640" Width="560"
        MinHeight="400" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e">

    <Window.Resources>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="70"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#585b70"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CredentialBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <!-- DockPanel pins Close button at bottom; ScrollViewer fills the rest -->
    <DockPanel>

        <!-- Always-visible Close button at bottom -->
        <Border DockPanel.Dock="Bottom" Background="#1e1e2e"
                BorderBrush="#313244" BorderThickness="0,1,0,0"
                Padding="32,12">
            <Button Content="Close" Click="CloseButton_Click"
                    Background="#585b70" Foreground="#cdd6f4"
                    BorderThickness="0" Padding="20,10" Cursor="Hand"
                    FontSize="13" HorizontalAlignment="Right"/>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel Margin="32,32,32,16">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="✅" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#a6e3a1" VerticalAlignment="Center">
                        <Run x:Name="TitleRun" Text="Tenant Created"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#6c7086"
                           Margin="0,0,0,24" TextWrapping="Wrap"/>

                <!-- Tenant ID -->
                <TextBlock Text="Tenant ID" Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="📋 Copy" Style="{StaticResource CopyButton}"
                            Click="CopyTenantId_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="TenantIdBox" Style="{StaticResource CredentialBox}"/>
                </DockPanel>

                <!-- License Key -->
                <TextBlock Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4">
                    <Run Text="License Key"/>
                    <Run Text=" — paste this when bat prompts 'License Key:'" Foreground="#6c7086"/>
                </TextBlock>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="📋 Copy" Style="{StaticResource CopyButton}"
                            Click="CopyLicenseKey_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="LicenseKeyBox" Style="{StaticResource CredentialBox}"/>
                </DockPanel>

                <!-- Admin Token -->
                <TextBlock Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4">
                    <Run Text="Admin Token"/>
                    <Run Text=" — give this to the sub-admin to log in" Foreground="#6c7086"/>
                </TextBlock>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="📋 Copy" Style="{StaticResource CopyButton}"
                            Click="CopyAdminToken_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="AdminTokenBox" Style="{StaticResource CredentialBox}"/>
                </DockPanel>

                <!-- Host Token -->
                <TextBlock Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4">
                    <Run Text="Host Token"/>
                    <Run Text=" — paste this when bat prompts 'Host Token:'" Foreground="#6c7086"/>
                </TextBlock>
                <DockPanel Margin="0,0,0,24">
                    <Button DockPanel.Dock="Right" Content="📋 Copy" Style="{StaticResource CopyButton}"
                            Click="CopyHostToken_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="HostTokenBox" Style="{StaticResource CredentialBox}"/>
                </DockPanel>

                <!-- Build hint -->
                <Border Background="#181825" BorderBrush="#313244" BorderThickness="1"
                        CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="To build the Host EXE for this sub-admin:"
                                   Foreground="#89b4fa" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#6c7086" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="1. Double-click "/>
                            <Run Text="BuildHostForSubAdmin.bat" Foreground="#cdd6f4" FontWeight="SemiBold"/>
                            <Run Text=" in the project folder"/>
                        </TextBlock>
                        <TextBlock Foreground="#6c7086" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="2. Paste the "/>
                            <Run Text="License Key" Foreground="#cdd6f4" FontWeight="SemiBold"/>
                            <Run Text=" when prompted"/>
                        </TextBlock>
                        <TextBlock Foreground="#6c7086" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="3. Paste the "/>
                            <Run Text="Host Token" Foreground="#cdd6f4" FontWeight="SemiBold"/>
                            <Run Text=" when prompted"/>
                        </TextBlock>
                        <TextBlock Text="4. Send BOTH Host.exe and host.key to the sub-admin (keep together!)"
                                   Foreground="#6c7086" FontSize="11"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
