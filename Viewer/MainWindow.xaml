<Window x:Class="RemoteAdminTool.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin — Dashboard" Height="720" Width="1280"
        Background="#1e1e2e">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ChatColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ======= Left Sidebar ======= -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Connection bar -->
                <StackPanel DockPanel.Dock="Top" Margin="12">
                    <TextBlock Text="Remote Admin" FontSize="18" FontWeight="Bold"
                               Foreground="#cba6f7" Margin="0,0,0,12"/>

                    <TextBlock Text="Relay Server" Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="RelayUrlBox" Text="wss://localhost:5050/relay"
                             Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                             Padding="8,6" FontSize="12"/>

                    <TextBlock Text="Admin Token" Foreground="#a6adc8" FontSize="11" Margin="0,8,0,4"/>
                    <PasswordBox x:Name="AdminTokenBox"
                                 Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                                 Padding="8,6" FontSize="12"/>

                    <Button x:Name="ConnectButton" Content="Connect to Relay"
                            Click="ConnectButton_Click"
                            Style="{StaticResource SidebarButton}"
                            Background="#7f849c" Foreground="#1e1e2e" FontWeight="SemiBold"
                            Margin="0,10,0,0"/>

                    <TextBlock x:Name="StatusText" Text="Disconnected"
                               Foreground="#f38ba8" FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="#313244" Margin="12,4"/>

                <!-- Node list header -->
                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                    <TextBlock Text="Online Nodes" FontSize="14" FontWeight="SemiBold"
                               Foreground="#a6e3a1" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Content="↻" Click="RefreshButton_Click"
                            HorizontalAlignment="Right" FontSize="16"
                            Style="{StaticResource SidebarButton}"
                            Padding="6,2" Margin="0"/>
                </DockPanel>

                <!-- Node list -->
                <ListBox x:Name="NodeList" Background="Transparent" BorderThickness="0"
                         Margin="8,0" SelectionChanged="NodeList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding MachineName}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#cdd6f4"/>
                                    <TextBlock FontSize="10" Foreground="#6c7086" Margin="0,2,0,0">
                                        <Run Text="{Binding MachineId, Mode=OneWay}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding OsVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======= Main Area: Remote Screen ======= -->
        <Grid Grid.Column="1">
            <!-- Session toolbar -->
            <Border x:Name="SessionToolbar" VerticalAlignment="Top" Background="#181825"
                    Padding="8,6" Visibility="Collapsed" Panel.ZIndex="10">
                <DockPanel>
                    <TextBlock x:Name="SessionHostName" Text=""
                               FontSize="13" FontWeight="SemiBold" Foreground="#cba6f7"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Monitor selector -->
                    <ComboBox x:Name="MonitorSelector" Width="140" Margin="12,0"
                              Background="#313244" Foreground="#cdd6f4"
                              SelectionChanged="MonitorSelector_SelectionChanged"
                              Visibility="Collapsed"/>

                    <!-- Toolbar buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📋 Clipboard" Click="ClipboardSyncButton_Click"
                                Style="{StaticResource SidebarButton}" Padding="8,4" FontSize="11"/>
                        <Button Content="📁 File Transfer" Click="FileTransferButton_Click"
                                Style="{StaticResource SidebarButton}" Padding="8,4" FontSize="11"/>
                        <Button Content="💬 Chat" Click="ChatToggleButton_Click"
                                Style="{StaticResource SidebarButton}" Padding="8,4" FontSize="11"/>
                        <Button x:Name="DisconnectSessionButton" Content="Disconnect"
                                Click="DisconnectSessionButton_Click"
                                Style="{StaticResource SidebarButton}"
                                Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                Padding="12,4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Remote screen image -->
            <Image x:Name="RemoteScreenImage"
                   Stretch="Uniform"
                   MouseMove="RemoteScreenImage_MouseMove"
                   MouseDown="RemoteScreenImage_MouseDown"
                   MouseUp="RemoteScreenImage_MouseUp"
                   MouseWheel="RemoteScreenImage_MouseWheel"
                   Focusable="True"
                   KeyDown="RemoteScreenImage_KeyDown"
                   KeyUp="RemoteScreenImage_KeyUp"
                   Margin="0,36,0,0"/>

            <!-- Placeholder -->
            <StackPanel x:Name="NoSessionPlaceholder"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No Active Session"
                           FontSize="24" Foreground="#6c7086" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a node from the sidebar to connect"
                           FontSize="13" Foreground="#45475a" HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ======= Chat Panel (right side, togglable) ======= -->
        <Border Grid.Column="2" Background="#181825" BorderBrush="#313244" BorderThickness="1,0,0,0">
            <DockPanel x:Name="ChatPanel" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Chat" FontSize="14" FontWeight="SemiBold"
                           Foreground="#f9e2af" Margin="12,8"/>

                <!-- Chat input -->
                <DockPanel DockPanel.Dock="Bottom" Margin="8">
                    <Button DockPanel.Dock="Right" Content="Send" Click="ChatSendButton_Click"
                            Style="{StaticResource SidebarButton}" Padding="12,6"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                    <TextBox x:Name="ChatInput" Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="8,6" FontSize="12"
                             KeyDown="ChatInput_KeyDown"/>
                </DockPanel>

                <!-- Chat messages -->
                <ListBox x:Name="ChatMessages" Background="Transparent" BorderThickness="0"
                         Margin="8,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Sender}" FontSize="10"
                                           Foreground="#89b4fa" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Text}" FontSize="12"
                                           Foreground="#cdd6f4" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
