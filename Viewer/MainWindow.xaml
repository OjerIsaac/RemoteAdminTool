<Window x:Class="RemoteAdminTool.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin - Dashboard" Height="780" Width="1380"
        Background="#1e1e2e">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6c7086"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device info row style -->
        <Style x:Key="DeviceRow" TargetType="Border">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ChatColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ======= Left Sidebar ======= -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- LOGIN FORM -->
                <StackPanel x:Name="LoginForm" DockPanel.Dock="Top" Margin="12">
                    <TextBlock Text="Remote Admin" FontSize="18" FontWeight="Bold"
                               Foreground="#cba6f7" Margin="0,0,0,12"/>
                    <TextBox x:Name="RelayUrlBox" Visibility="Collapsed"/>
                    <TextBlock Text="Admin Token" Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="AdminTokenBox"
                                 Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                                 Padding="8,6" FontSize="12"/>
                    <TextBlock x:Name="LicenseKeyLabel" Text="License Key (Sub-Admin)" Foreground="#a6adc8"
                               FontSize="11" Margin="0,8,0,4"/>
                    <TextBox x:Name="LicenseKeyBox"
                             Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                             Padding="8,6" FontSize="12"/>
                    <Button x:Name="ConnectButton" Content="Connect to Relay"
                            Click="ConnectButton_Click"
                            Style="{StaticResource SidebarButton}"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                            Margin="0,10,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Not connected"
                               Foreground="#f38ba8" FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- LOGGED-IN BAR -->
                <Border x:Name="LoggedInBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="#1e1e2e" Margin="10,10,10,4"
                        CornerRadius="8" Padding="10,8">
                    <DockPanel>
                        <Button x:Name="LogoutButton" Content="Logout"
                                Click="LogoutButton_Click"
                                DockPanel.Dock="Right"
                                Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                FontSize="11" Padding="10,4" BorderThickness="0"
                                Cursor="Hand"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LoggedInLabel" Text="Connected"
                                       Foreground="#a6e3a1" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LoggedInRole" Text=""
                                       Foreground="#6c7086" FontSize="10"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1" Background="#313244" Margin="12,4"/>

                <!-- Sidebar tab bar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
                    <Button x:Name="TabNodesButton" Content="Nodes"
                            Style="{StaticResource TabButton}"
                            Click="TabNodesButton_Click"
                            Foreground="#a6e3a1" BorderBrush="#a6e3a1"/>
                    <Button x:Name="TabTenantsButton" Content="Tenants"
                            Style="{StaticResource TabButton}"
                            Click="TabTenantsButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>

                <!-- Nodes panel -->
                <DockPanel x:Name="NodePanel" DockPanel.Dock="Top" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="Online Nodes" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#a6e3a1" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Content="↻" Click="RefreshButton_Click"
                                HorizontalAlignment="Right" FontSize="16"
                                Style="{StaticResource SidebarButton}"
                                Padding="6,2" Margin="0"/>
                    </DockPanel>
                    <ListBox x:Name="NodeList" Background="Transparent" BorderThickness="0"
                             Margin="8,0" SelectionChanged="NodeList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MachineName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#cdd6f4"/>
                                        <TextBlock FontSize="10" Foreground="#6c7086" Margin="0,2,0,0">
                                            <Run Text="{Binding MachineId, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding OsVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="TenantLabel" FontSize="9" Foreground="#89b4fa"
                                                   Margin="0,2,0,0" Visibility="Collapsed">
                                            <Run Text="Tenant: "/>
                                            <Run Text="{Binding TenantId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Tenants panel (super admin only) -->
                <DockPanel x:Name="TenantPanel" DockPanel.Dock="Top" Visibility="Collapsed" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="Sub-Admins" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#cba6f7" VerticalAlignment="Center"/>
                        <Button x:Name="CreateTenantButton" Content="+ New"
                                Click="CreateTenantButton_Click"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SidebarButton}"
                                Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold"
                                Padding="8,4" Margin="0" FontSize="11"/>
                    </DockPanel>
                    <ListBox x:Name="TenantList" Background="Transparent" BorderThickness="0"
                             Margin="8,0" SelectionChanged="TenantList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="2">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Content="Details"
                                                    Tag="{Binding}"
                                                    Click="ViewTenantDetails_Click"
                                                    Style="{StaticResource SidebarButton}"
                                                    Background="#89b4fa" Foreground="#1e1e2e"
                                                    Padding="6,2" Margin="0,0,4,0" FontSize="10"/>
                                            <Button Tag="{Binding TenantId}"
                                                    Click="SuspendTenantButton_Click"
                                                    Padding="6,2" Margin="0" FontSize="10">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                                        <Setter Property="Content" Value="Suspend"/>
                                                        <Setter Property="Background" Value="#f38ba8"/>
                                                        <Setter Property="Foreground" Value="#1e1e2e"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content" Value="Resume"/>
                                                                <Setter Property="Background" Value="#a6e3a1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#cdd6f4"/>
                                            <TextBlock FontSize="10" Foreground="#6c7086" Margin="0,2,0,0">
                                                <Run Text="{Binding OnlineNodeCount, Mode=OneWay}"/>
                                                <Run Text=" nodes  -  "/>
                                                <Run Text="{Binding AdminEmail, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="9" Margin="0,2,0,0"
                                                       Text="{Binding StatusLabel, Mode=OneWay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#a6e3a1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#f38ba8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ======= Main Area ======= -->
        <Grid Grid.Column="1">
            <!-- Session toolbar -->
            <Border x:Name="SessionToolbar" VerticalAlignment="Top" Background="#181825"
                    Padding="8,6" Visibility="Collapsed" Panel.ZIndex="10">
                <DockPanel>
                    <TextBlock x:Name="SessionHostName" Text=""
                               FontSize="13" FontWeight="SemiBold" Foreground="#cba6f7"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Session tab buttons -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Button x:Name="TabScreenBtn" Content="Screen"
                                Click="TabScreenBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"
                                Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                        <Button x:Name="TabConsoleBtn" Content="Terminal"
                                Click="TabConsoleBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabCodeBtn" Content="Code"
                                Click="TabCodeBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabFilesBtn" Content="Files"
                                Click="TabFilesBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabDeviceBtn" Content="Device"
                                Click="TabDeviceBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabMonitorBtn" Content="Monitor"
                                Click="TabMonitorBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                    </StackPanel>

                    <!-- Monitor selector -->
                    <ComboBox x:Name="MonitorSelector" Width="130" Margin="8,0"
                              Background="#313244" Foreground="#cdd6f4"
                              SelectionChanged="MonitorSelector_SelectionChanged"
                              Visibility="Collapsed"/>

                    <!-- Right toolbar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Silent mode toggle -->
                        <Border Background="#313244" CornerRadius="6" Margin="4" Padding="8,4"
                                ToolTip="When ON: host auto-accepts connections without showing a consent dialog">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Silent" Foreground="#a6adc8" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <CheckBox x:Name="SilentModeCheckBox"
                                          Checked="SilentModeCheckBox_Changed"
                                          Unchecked="SilentModeCheckBox_Changed"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Clipboard" Click="ClipboardSyncButton_Click"
                                Style="{StaticResource SidebarButton}" Padding="8,4" FontSize="11"/>
                        <Button Content="Chat" Click="ChatToggleButton_Click"
                                Style="{StaticResource SidebarButton}" Padding="8,4" FontSize="11"/>
                        <Button x:Name="DisconnectSessionButton" Content="Disconnect"
                                Click="DisconnectSessionButton_Click"
                                Style="{StaticResource SidebarButton}"
                                Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                Padding="12,4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- TAB: Screen -->
            <Grid x:Name="ScreenTab" Margin="0,38,0,0">
                <Image x:Name="RemoteScreenImage"
                       Stretch="Uniform"
                       MouseMove="RemoteScreenImage_MouseMove"
                       MouseDown="RemoteScreenImage_MouseDown"
                       MouseUp="RemoteScreenImage_MouseUp"
                       MouseWheel="RemoteScreenImage_MouseWheel"
                       MouseEnter="RemoteScreenImage_MouseEnter"
                       MouseLeave="RemoteScreenImage_MouseLeave"
                       Focusable="True"
                       KeyDown="RemoteScreenImage_KeyDown"
                       KeyUp="RemoteScreenImage_KeyUp"/>
                <!-- Crosshair dot overlay - shown when cursor is hidden -->
                <Canvas x:Name="CursorOverlay" IsHitTestVisible="False">
                    <Ellipse x:Name="CursorDot" Width="10" Height="10"
                             Fill="#89b4fa" Opacity="0.85"
                             Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- TAB: Terminal (improved - RichTextBox + history) -->
            <DockPanel x:Name="ConsolePanel" Visibility="Collapsed" Margin="0,38,0,0"
                       Background="#11111b">
                <!-- Toolbar: shell selector -->
                <Border DockPanel.Dock="Top" Background="#1e1e2e" Padding="8,4"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Shell:" Foreground="#6c7086" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ShellTypeCombo" Width="120" FontSize="11"
                                  Background="#313244" Foreground="#cdd6f4"
                                  SelectionChanged="ShellTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="PowerShell" IsSelected="True"/>
                            <ComboBoxItem Content="CMD"/>
                        </ComboBox>
                        <Button Content="Clear" Click="ConsoleClearBtn_Click"
                                Style="{StaticResource SidebarButton}"
                                Padding="8,2" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Input row pinned to bottom -->
                <Border DockPanel.Dock="Bottom" Background="#1e1e2e" Padding="8,6"
                        BorderBrush="#313244" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run" Width="60"
                                Click="ConsoleRunBtn_Click"
                                Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                                FontFamily="Consolas" FontSize="12" Margin="8,0,0,0"
                                BorderThickness="0" Padding="0"/>
                        <TextBlock DockPanel.Dock="Left" Text="PS>" Foreground="#a6e3a1"
                                   FontFamily="Consolas" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ConsoleInput"
                                 Background="#313244" Foreground="#cdd6f4"
                                 FontFamily="Consolas" FontSize="13"
                                 BorderBrush="#45475a" BorderThickness="1"
                                 Padding="8,4" CaretBrush="#cdd6f4"
                                 KeyDown="ConsoleInput_KeyDown"
                                 ToolTip="Type a command and press Enter or Run. Up/Down arrows cycle history."/>
                    </DockPanel>
                </Border>

                <!-- RichTextBox output area -->
                <ScrollViewer x:Name="ConsoleScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#11111b">
                    <RichTextBox x:Name="ConsoleOutput"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="13"
                                 Background="Transparent"
                                 BorderThickness="0" Padding="12,10"
                                 IsDocumentEnabled="True"/>
                </ScrollViewer>
            </DockPanel>

            <!-- TAB: Code Editor -->
            <DockPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,38,0,0"
                       Background="#11111b">
                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Background="#1e1e2e" Padding="8,4"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Language:" Foreground="#6c7086" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CodeLanguageCombo" Width="120" FontSize="11"
                                      Background="#313244" Foreground="#cdd6f4">
                                <ComboBoxItem Content="PowerShell" IsSelected="True"/>
                                <ComboBoxItem Content="Batch (CMD)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear Output" Click="CodeClearOutputBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"/>
                            <Button Content="Run Script" Click="CodeRunBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="12,2" FontSize="11"
                                    Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Split: editor top, output bottom -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- Code editor area -->
                    <Border Grid.Row="0" Background="#1e1e2e" Margin="0">
                        <TextBox x:Name="CodeEditor"
                                 FontFamily="Consolas" FontSize="13"
                                 Background="Transparent" Foreground="#cdd6f4"
                                 BorderThickness="0" Padding="12,10"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 CaretBrush="#cdd6f4"
                                 Text="# Write your PowerShell script here and click Run Script"/>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="#313244"/>

                    <!-- Output -->
                    <Border Grid.Row="2" Background="#11111b">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Output"
                                       Foreground="#6c7086" FontSize="11"
                                       Padding="12,4" Background="#1e1e2e"/>
                            <ScrollViewer x:Name="CodeOutputScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <RichTextBox x:Name="CodeOutput"
                                             IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="12"
                                             Background="Transparent" Foreground="#cdd6f4"
                                             BorderThickness="0" Padding="12,6"
                                             IsDocumentEnabled="True"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- TAB: File Manager -->
            <DockPanel x:Name="FilesPanel" Visibility="Collapsed" Margin="0,38,0,0"
                       Background="#11111b">
                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Background="#1e1e2e" Padding="8,6"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Remote:" Foreground="#6c7086" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RemotePathBox"
                                     Text="\" Width="280" FontSize="11" FontFamily="Consolas"
                                     Background="#313244" Foreground="#cdd6f4"
                                     BorderBrush="#45475a" Padding="6,3"
                                     KeyDown="RemotePathBox_KeyDown"/>
                            <Button Content="Go" Click="RemotePathGoBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="4,0"/>
                            <Button Content="Up" Click="RemotePathUpBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Upload to Host" Click="UploadToHostBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"
                                    Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                            <Button Content="Download" Click="DownloadFromHostBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"
                                    Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                            <Button Content="Delete" Click="DeleteRemoteBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"
                                    Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Transfer progress bar (hidden when idle) -->
                <Border x:Name="TransferProgressBar" DockPanel.Dock="Bottom"
                        Background="#1e1e2e" Padding="12,6" Visibility="Collapsed"
                        BorderBrush="#313244" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock x:Name="TransferStatusText" Text="Transferring..."
                                   Foreground="#f9e2af" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="TransferProgress" Height="12"
                                     Background="#313244" Foreground="#89b4fa"
                                     Minimum="0" Maximum="100" Value="0"/>
                    </DockPanel>
                </Border>

                <!-- File listing -->
                <ListView x:Name="RemoteFileList"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#cdd6f4" FontSize="12"
                          MouseDoubleClick="RemoteFileList_DoubleClick"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="300"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="80"
                                            DisplayMemberBinding="{Binding TypeLabel}"/>
                            <GridViewColumn Header="Size" Width="100"
                                            DisplayMemberBinding="{Binding SizeLabel}"/>
                            <GridViewColumn Header="Modified" Width="160"
                                            DisplayMemberBinding="{Binding LastModified}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- TAB: Device Info -->
            <ScrollViewer x:Name="DevicePanel" Visibility="Collapsed" Margin="0,38,0,0"
                          VerticalScrollBarVisibility="Auto" Background="#11111b">
                <StackPanel Margin="20,16">
                    <TextBlock Text="Device Information" Foreground="#cba6f7"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Machine section -->
                    <TextBlock Text="Machine" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Machine Name" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevMachineName" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Username / Domain" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevUsername" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OS section -->
                    <TextBlock Text="Operating System" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OS Version" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevOsVersion" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Build / Timezone" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevOsBuild" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Uptime" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevUptime" Foreground="#a6e3a1" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hardware section -->
                    <TextBlock Text="Hardware" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevCpu" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cores" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevCores" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RAM Total" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevRam" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage section -->
                    <TextBlock Text="Storage" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Drive" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevSystemDrive" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Free Space" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevDriveFree" Foreground="#a6e3a1" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Size" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevDriveTotal" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Network section -->
                    <TextBlock Text="Network" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <StackPanel>
                            <TextBlock Text="IP Addresses" Foreground="#6c7086" FontSize="11"/>
                            <TextBlock x:Name="DevIpAddresses" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB: Monitor -->
            <ScrollViewer x:Name="MonitorPanel" Visibility="Collapsed" Margin="0,38,0,0"
                          VerticalScrollBarVisibility="Auto" Background="#11111b">
                <StackPanel Margin="16,12">
                    <TextBlock Text="CPU Usage" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Border Background="#1e1e2e" CornerRadius="4" Height="18"/>
                        <Border x:Name="CpuBar" Background="#89b4fa" CornerRadius="4" Height="18"
                                HorizontalAlignment="Left" Width="0"/>
                        <TextBlock x:Name="CpuLabel" Text="0%" Foreground="#cdd6f4" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Memory (RAM)" Foreground="#a6e3a1" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Border Background="#1e1e2e" CornerRadius="4" Height="18"/>
                        <Border x:Name="RamBar" Background="#a6e3a1" CornerRadius="4" Height="18"
                                HorizontalAlignment="Left" Width="0"/>
                        <TextBlock x:Name="RamLabel" Text="0 / 0 MB" Foreground="#cdd6f4" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Disk Read" Foreground="#f9e2af" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DiskReadLabel" Text="0 MB/s"
                                       Foreground="#cdd6f4" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Disk Write" Foreground="#f9e2af" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DiskWriteLabel" Text="0 MB/s"
                                       Foreground="#cdd6f4" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Net Sent" Foreground="#cba6f7" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="NetSentLabel" Text="0 MB/s"
                                       Foreground="#cdd6f4" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Net Recv" Foreground="#cba6f7" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="NetRecvLabel" Text="0 MB/s"
                                       Foreground="#cdd6f4" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Top Processes (by RAM)" Foreground="#f38ba8" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#1e1e2e" CornerRadius="6" Padding="8">
                        <ItemsControl x:Name="ProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RamMb, StringFormat='{}{0} MB'}"
                                                   Foreground="#6c7086" FontSize="11" FontFamily="Consolas"
                                                   Width="60" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#cdd6f4" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Placeholder (no session) -->
            <StackPanel x:Name="NoSessionPlaceholder"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No Active Session"
                           FontSize="24" Foreground="#6c7086" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a node from the sidebar to connect"
                           FontSize="13" Foreground="#45475a" HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Chat Panel -->
        <Border Grid.Column="2" Background="#181825" BorderBrush="#313244" BorderThickness="1,0,0,0">
            <DockPanel x:Name="ChatPanel" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Chat" FontSize="14" FontWeight="SemiBold"
                           Foreground="#f9e2af" Margin="12,8"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="8">
                    <Button DockPanel.Dock="Right" Content="Send" Click="ChatSendButton_Click"
                            Style="{StaticResource SidebarButton}" Padding="12,6"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                    <TextBox x:Name="ChatInput" Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="8,6" FontSize="12"
                             KeyDown="ChatInput_KeyDown"/>
                </DockPanel>
                <ListBox x:Name="ChatMessages" Background="Transparent" BorderThickness="0"
                         Margin="8,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Sender}" FontSize="10"
                                           Foreground="#89b4fa" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Text}" FontSize="12"
                                           Foreground="#cdd6f4" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
