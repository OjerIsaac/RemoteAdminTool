<Window x:Class="RemoteAdminTool.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Admin - Dashboard" Height="780" Width="1380"
        Background="#1e1e2e">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6c7086"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Device info row style -->
        <Style x:Key="DeviceRow" TargetType="Border">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Monitor card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======= Left Sidebar ======= -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- LOGIN FORM -->
                <StackPanel x:Name="LoginForm" DockPanel.Dock="Top" Margin="12">
                    <TextBlock Text="Remote Admin" FontSize="18" FontWeight="Bold"
                               Foreground="#cba6f7" Margin="0,0,0,12"/>
                    <TextBox x:Name="RelayUrlBox" Visibility="Collapsed"/>
                    <TextBlock Text="Admin Token" Foreground="#a6adc8" FontSize="11" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="AdminTokenBox"
                                 Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                                 Padding="8,6" FontSize="12"/>
                    <TextBlock x:Name="LicenseKeyLabel" Text="License Key (Sub-Admin)" Foreground="#a6adc8"
                               FontSize="11" Margin="0,8,0,4"/>
                    <TextBox x:Name="LicenseKeyBox"
                             Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                             Padding="8,6" FontSize="12"/>
                    <Button x:Name="ConnectButton" Content="Connect to Relay"
                            Click="ConnectButton_Click"
                            Style="{StaticResource SidebarButton}"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                            Margin="0,10,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Not connected"
                               Foreground="#f38ba8" FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- LOGGED-IN BAR -->
                <Border x:Name="LoggedInBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="#1e1e2e" Margin="10,10,10,4"
                        CornerRadius="8" Padding="10,8">
                    <DockPanel>
                        <Button x:Name="LogoutButton" Content="Logout"
                                Click="LogoutButton_Click"
                                DockPanel.Dock="Right"
                                Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                FontSize="11" Padding="10,4" BorderThickness="0"
                                Cursor="Hand"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LoggedInLabel" Text="Connected"
                                       Foreground="#a6e3a1" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LoggedInRole" Text=""
                                       Foreground="#6c7086" FontSize="10"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Height="1" Background="#313244" Margin="12,4"/>

                <!-- Sidebar tab bar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
                    <Button x:Name="TabNodesButton" Content="Nodes"
                            Style="{StaticResource TabButton}"
                            Click="TabNodesButton_Click"
                            Foreground="#a6e3a1" BorderBrush="#a6e3a1"/>
                    <Button x:Name="TabTenantsButton" Content="Tenants"
                            Style="{StaticResource TabButton}"
                            Click="TabTenantsButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>

                <!-- Nodes panel -->
                <DockPanel x:Name="NodePanel" DockPanel.Dock="Top" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="Online Nodes" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#a6e3a1" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Content="↻" Click="RefreshButton_Click"
                                HorizontalAlignment="Right" FontSize="16"
                                Style="{StaticResource SidebarButton}"
                                Padding="6,2" Margin="0"/>
                    </DockPanel>
                    <ListBox x:Name="NodeList" Background="Transparent" BorderThickness="0"
                             Margin="8,0" SelectionChanged="NodeList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="2">
                                    <StackPanel>
                                        <!-- PC name - big and bold -->
                                        <TextBlock Text="{Binding MachineName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#cdd6f4"/>
                                        <!-- OS version -->
                                        <TextBlock Text="{Binding OsVersion, Mode=OneWay}"
                                                   FontSize="10" Foreground="#6c7086" Margin="0,2,0,0"/>
                                        <!-- Short unique machine ID -->
                                        <TextBlock FontSize="9" Foreground="#45475a" Margin="0,1,0,0">
                                            <Run Text="ID: "/><Run Text="{Binding ShortId, Mode=OneWay}" Foreground="#585b70"/>
                                        </TextBlock>
                                        <!-- Tenant label (super admin only) -->
                                        <TextBlock x:Name="TenantLabel" FontSize="9" Foreground="#89b4fa"
                                                   Margin="0,2,0,0" Visibility="Collapsed">
                                            <Run Text="Tenant: "/>
                                            <Run Text="{Binding TenantId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Tenants panel (super admin only) -->
                <DockPanel x:Name="TenantPanel" DockPanel.Dock="Top" Visibility="Collapsed" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="Sub-Admins" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#cba6f7" VerticalAlignment="Center"/>
                        <Button x:Name="CreateTenantButton" Content="+ New"
                                Click="CreateTenantButton_Click"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SidebarButton}"
                                Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold"
                                Padding="8,4" Margin="0" FontSize="11"/>
                    </DockPanel>
                    <ListBox x:Name="TenantList" Background="Transparent" BorderThickness="0"
                             Margin="8,0" SelectionChanged="TenantList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="2">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Content="Details"
                                                    Tag="{Binding}"
                                                    Click="ViewTenantDetails_Click"
                                                    Style="{StaticResource SidebarButton}"
                                                    Background="#89b4fa" Foreground="#1e1e2e"
                                                    Padding="6,2" Margin="0,0,4,0" FontSize="10"/>
                                            <Button Tag="{Binding TenantId}"
                                                    Click="SuspendTenantButton_Click"
                                                    Padding="6,2" Margin="0" FontSize="10">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                                        <Setter Property="Content" Value="Suspend"/>
                                                        <Setter Property="Background" Value="#f38ba8"/>
                                                        <Setter Property="Foreground" Value="#1e1e2e"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content" Value="Resume"/>
                                                                <Setter Property="Background" Value="#a6e3a1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#cdd6f4"/>
                                            <TextBlock FontSize="10" Foreground="#6c7086" Margin="0,2,0,0">
                                                <Run Text="{Binding OnlineNodeCount, Mode=OneWay}"/>
                                                <Run Text=" nodes  -  "/>
                                                <Run Text="{Binding AdminEmail, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="9" Margin="0,2,0,0"
                                                       Text="{Binding StatusLabel, Mode=OneWay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#a6e3a1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#f38ba8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ======= Main Area ======= -->
        <Grid Grid.Column="1">
            <!-- Session toolbar -->
            <Border x:Name="SessionToolbar" VerticalAlignment="Top" Background="#181825"
                    Padding="8,6" Visibility="Collapsed" Panel.ZIndex="10">
                <DockPanel>
                    <TextBlock x:Name="SessionHostName" Text=""
                               FontSize="13" FontWeight="SemiBold" Foreground="#cba6f7"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Session tab buttons -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Button x:Name="TabScreenBtn" Content="Screen"
                                Click="TabScreenBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"
                                Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                        <Button x:Name="TabConsoleBtn" Content="Terminal"
                                Click="TabConsoleBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabFilesBtn" Content="Files"
                                Click="TabFilesBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabDeviceBtn" Content="Device"
                                Click="TabDeviceBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                        <Button x:Name="TabMonitorBtn" Content="Monitor"
                                Click="TabMonitorBtn_Click"
                                Style="{StaticResource SidebarButton}" Padding="10,4" FontSize="11"/>
                    </StackPanel>

                    <!-- Monitor selector -->
                    <ComboBox x:Name="MonitorSelector" Width="130" Margin="8,0"
                              Background="#313244" Foreground="#cdd6f4"
                              SelectionChanged="MonitorSelector_SelectionChanged"
                              Visibility="Collapsed"/>

                    <!-- Right toolbar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Silent mode toggle -->
                        <Border Background="#313244" CornerRadius="6" Margin="4" Padding="8,4"
                                ToolTip="When ON: host auto-accepts connections without showing a consent dialog">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Silent" Foreground="#a6adc8" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <CheckBox x:Name="SilentModeCheckBox"
                                          Checked="SilentModeCheckBox_Changed"
                                          Unchecked="SilentModeCheckBox_Changed"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DisconnectSessionButton" Content="Disconnect"
                                Click="DisconnectSessionButton_Click"
                                Style="{StaticResource SidebarButton}"
                                Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                Padding="12,4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Connecting overlay: shown when node is clicked, hidden once session starts -->
            <Border x:Name="ConnectingOverlay" Visibility="Collapsed" Panel.ZIndex="20"
                    Background="#CC1e1e2e">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectingLabel"
                               Text="Connecting..."
                               Foreground="#89b4fa" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                                 Margin="0,16,0,0"
                                 Foreground="#89b4fa" Background="#313244"
                                 BorderThickness="0"/>
                    <TextBlock Text="Waiting for host to accept..."
                               Foreground="#6c7086" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- TAB: Screen -->
            <Grid x:Name="ScreenTab" Margin="0,38,0,0">
                <Image x:Name="RemoteScreenImage"
                       Stretch="Uniform"
                       MouseMove="RemoteScreenImage_MouseMove"
                       MouseDown="RemoteScreenImage_MouseDown"
                       MouseUp="RemoteScreenImage_MouseUp"
                       MouseWheel="RemoteScreenImage_MouseWheel"
                       MouseEnter="RemoteScreenImage_MouseEnter"
                       MouseLeave="RemoteScreenImage_MouseLeave"
                       Focusable="True"
                       KeyDown="RemoteScreenImage_KeyDown"
                       KeyUp="RemoteScreenImage_KeyUp"/>
                <!-- Crosshair dot overlay - shown when cursor is hidden -->
                <Canvas x:Name="CursorOverlay" IsHitTestVisible="False">
                    <Ellipse x:Name="CursorDot" Width="10" Height="10"
                             Fill="#89b4fa" Opacity="0.85"
                             Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- TAB: Terminal (improved - RichTextBox + history + Admin Mode) -->
            <DockPanel x:Name="ConsolePanel" Visibility="Collapsed" Margin="0,38,0,0"
                       Background="#11111b">
                <!-- Toolbar: shell selector + Admin indicator -->
                <Border DockPanel.Dock="Top" Background="#1e1e2e" Padding="8,4"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shell:" Foreground="#6c7086" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ShellTypeCombo" Width="130" FontSize="11"
                                      Background="#313244" Foreground="#cdd6f4"
                                      SelectionChanged="ShellTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="PowerShell" IsSelected="True"/>
                                <ComboBoxItem Content="CMD"/>
                            </ComboBox>
                            <Border x:Name="AdminBadge" Background="#26382b" BorderBrush="#a6e3a1" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AdminBadgeText" Text="🛡️ ADMINISTRATOR" Foreground="#a6e3a1" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Button Content="Clear" Click="ConsoleClearBtn_Click"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,2" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ElevateHostBtn" Content="⚡ Elevate Host to Admin" Click="ElevateHostBtn_Click"
                                    Style="{StaticResource SidebarButton}"
                                    Background="#f9e2af" Foreground="#1e1e2e" FontWeight="SemiBold"
                                    Padding="10,2" FontSize="11" Margin="0"
                                    ToolTip="Relaunches the Host agent with elevated administrator privileges"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Input row pinned to bottom -->
                <Border DockPanel.Dock="Bottom" Background="#1e1e2e" Padding="8,6"
                        BorderBrush="#313244" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run" Width="60"
                                Click="ConsoleRunBtn_Click"
                                Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                                FontFamily="Consolas" FontSize="12" Margin="8,0,0,0"
                                BorderThickness="0" Padding="0"/>
                        <TextBlock DockPanel.Dock="Left" Text="PS>" Foreground="#a6e3a1"
                                   FontFamily="Consolas" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ConsoleInput"
                                 Background="#313244" Foreground="#cdd6f4"
                                 FontFamily="Consolas" FontSize="13"
                                 BorderBrush="#45475a" BorderThickness="1"
                                 Padding="8,4" CaretBrush="#cdd6f4"
                                 KeyDown="ConsoleInput_KeyDown"
                                 ToolTip="Type a command and press Enter or Run. Up/Down arrows cycle history."/>
                    </DockPanel>
                </Border>

                <!-- RichTextBox output area -->
                <ScrollViewer x:Name="ConsoleScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#11111b">
                    <RichTextBox x:Name="ConsoleOutput"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="13"
                                 Background="Transparent"
                                 BorderThickness="0" Padding="12,10"
                                 IsDocumentEnabled="True"/>
                </ScrollViewer>
            </DockPanel>

            <!-- TAB: File Explorer -->
            <DockPanel x:Name="FilesPanel" Visibility="Collapsed" Margin="0,38,0,0"
                       Background="#11111b">
                <!-- Top Quick Navigation & Drive Bar -->
                <Border DockPanel.Dock="Top" Background="#181825" Padding="8,4"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Quick Access:" Foreground="#6c7086" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="💾 All Drives" Click="QuickDriveRoot_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                            <Button Content="💽 C:\" Click="QuickDriveC_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                            <Button Content="🖥️ Desktop" Click="QuickDesktop_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                            <Button Content="📥 Downloads" Click="QuickDownloads_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                            <Button Content="📄 Documents" Click="QuickDocuments_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                            <Button Content="⚙️ Temp" Click="QuickTemp_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="2,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navigation & Action Toolbar -->
                <Border DockPanel.Dock="Top" Background="#1e1e2e" Padding="8,6"
                        BorderBrush="#313244" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⬆ Up" Click="RemotePathUpBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="🔄 Refresh" Click="RemotePathRefreshBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="Path:" Foreground="#6c7086" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="RemotePathBox"
                                     Text="\" Width="360" FontSize="11" FontFamily="Consolas"
                                     Background="#313244" Foreground="#cdd6f4"
                                     BorderBrush="#45475a" Padding="6,3"
                                     KeyDown="RemotePathBox_KeyDown"/>
                            <Button Content="Go" Click="RemotePathGoBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📥 Import to Host" Click="UploadToHostBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="10,2" FontSize="11"
                                    Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                            <Button Content="📤 Export to PC" Click="DownloadFromHostBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="10,2" FontSize="11"
                                    Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                            <Button Content="🗑 Delete" Click="DeleteRemoteBtn_Click"
                                    Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"
                                    Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Transfer progress bar (hidden when idle) -->
                <Border x:Name="TransferProgressBar" DockPanel.Dock="Bottom"
                        Background="#1e1e2e" Padding="12,6" Visibility="Collapsed"
                        BorderBrush="#313244" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock x:Name="TransferStatusText" Text="Transferring..."
                                   Foreground="#f9e2af" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="TransferProgress" Height="12"
                                     Background="#313244" Foreground="#89b4fa"
                                     Minimum="0" Maximum="100" Value="0"/>
                    </DockPanel>
                </Border>

                <!-- File listing -->
                <ListView x:Name="RemoteFileList"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#cdd6f4" FontSize="12"
                          MouseDoubleClick="RemoteFileList_DoubleClick"
                          SelectionMode="Single">
                    <ListView.ContextMenu>
                        <ContextMenu Background="#1e1e2e" Foreground="#cdd6f4">
                            <MenuItem Header="📤 Export to PC (Download)" Click="DownloadFromHostBtn_Click"/>
                            <MenuItem Header="📥 Import File Here (Upload)" Click="UploadToHostBtn_Click"/>
                            <Separator Background="#313244"/>
                            <MenuItem Header="🗑 Delete" Click="DeleteRemoteBtn_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="36"
                                            DisplayMemberBinding="{Binding Icon}"/>
                            <GridViewColumn Header="Name" Width="360"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="90"
                                            DisplayMemberBinding="{Binding TypeLabel}"/>
                            <GridViewColumn Header="Size" Width="100"
                                            DisplayMemberBinding="{Binding SizeLabel}"/>
                            <GridViewColumn Header="Modified" Width="150"
                                            DisplayMemberBinding="{Binding LastModified}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- TAB: Device Info -->
            <ScrollViewer x:Name="DevicePanel" Visibility="Collapsed" Margin="0,38,0,0"
                          VerticalScrollBarVisibility="Auto" Background="#11111b">
                <StackPanel Margin="20,16">
                    <TextBlock Text="Device Information" Foreground="#cba6f7"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Machine section -->
                    <TextBlock Text="Machine" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Machine Name" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevMachineName" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Username / Domain" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevUsername" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OS section -->
                    <TextBlock Text="Operating System" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OS Version" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevOsVersion" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Build / Timezone" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevOsBuild" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Uptime" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevUptime" Foreground="#a6e3a1" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hardware section -->
                    <TextBlock Text="Hardware" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevCpu" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cores" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevCores" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RAM Total" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevRam" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Storage section -->
                    <TextBlock Text="Storage" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Drive" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevSystemDrive" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Free Space" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevDriveFree" Foreground="#a6e3a1" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Size" Foreground="#6c7086" FontSize="11"/>
                                <TextBlock x:Name="DevDriveTotal" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Network section -->
                    <TextBlock Text="Network" Foreground="#89b4fa" FontSize="12"
                               FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Border Style="{StaticResource DeviceRow}">
                        <StackPanel>
                            <TextBlock Text="IP Addresses" Foreground="#6c7086" FontSize="11"/>
                            <TextBlock x:Name="DevIpAddresses" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB: Monitor -->
            <ScrollViewer x:Name="MonitorPanel" Visibility="Collapsed" Margin="0,38,0,0"
                          VerticalScrollBarVisibility="Auto" Background="#11111b">
                <StackPanel Margin="20,16" MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- Header: Machine & System Inventory Summary -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MOTHERBOARD" Foreground="#6c7086" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Motherboard}" Foreground="#cdd6f4" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Bios, StringFormat='BIOS: {0}'}" Foreground="#a6adc8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SYSTEM UPTIME" Foreground="#6c7086" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Uptime}" Foreground="#a6e3a1" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding BatteryInfo}" Foreground="#f9e2af" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DISK &amp; NET THROUGHPUT" Foreground="#6c7086" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DiskReadRate, StringFormat='Disk R: {0}'}" Foreground="#89b4fa" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding DiskWriteRate, StringFormat='Disk W: {0}'}" Foreground="#89b4fa" FontSize="11"/>
                                <TextBlock Text="{Binding NetSentRate, StringFormat='Net Up: {0}'}" Foreground="#cba6f7" FontSize="11"/>
                                <TextBlock Text="{Binding NetRecvRate, StringFormat='Net Down: {0}'}" Foreground="#cba6f7" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CPU Section: Total & Per Core -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="CPU &amp; PROCESSOR" Foreground="#89b4fa" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CpuPercentText}" Foreground="#89b4fa" FontSize="14" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CpuName}" Foreground="#cdd6f4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CpuDetails}" Foreground="#6c7086" FontSize="11" Margin="0,0,10,0" TextWrapping="Wrap"/>

                            <!-- Overall CPU Bar -->
                            <Grid Margin="0,4,0,12">
                                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding CpuPercent}"
                                             Background="#313244" Foreground="#89b4fa" BorderThickness="0"/>
                            </Grid>

                            <!-- Per Core Multi-Bar Grid -->
                            <TextBlock Text="Logical Cores Utilization" Foreground="#a6adc8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="6,4" Margin="0,0,8,8" Width="120">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding CoreLabel}" Foreground="#6c7086" FontSize="10"/>
                                                    <TextBlock Text="{Binding UsageText}" Foreground="#cdd6f4" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding UsagePercent}"
                                                             Background="#313244" Foreground="#89b4fa" BorderThickness="0" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Memory Section -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="SYSTEM MEMORY (RAM)" Foreground="#a6e3a1" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding RamText}" Foreground="#a6e3a1" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding RamPercent}"
                                         Background="#313244" Foreground="#a6e3a1" BorderThickness="0" Margin="0,0,0,12"/>

                            <!-- Physical Memory Modules / Sticks -->
                            <TextBlock Text="Installed Physical Memory Modules (Sticks)" Foreground="#a6adc8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding MemoryModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Slot}" Foreground="#cdd6f4" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Capacity}" Foreground="#a6e3a1" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TypeAndSpeed}" Foreground="#89b4fa" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Manufacturer, StringFormat='Mfr: {0}'}" Foreground="#a6adc8" FontSize="11"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PartNumber, StringFormat='Part: {0}'}" Foreground="#6c7086" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Storage Section (Volumes & Physical Disks) -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="STORAGE &amp; DRIVES" Foreground="#f9e2af" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                            <!-- Logical Volumes -->
                            <TextBlock Text="Logical Volumes / Partitions" Foreground="#a6adc8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Volumes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DriveLetter}" Foreground="#f9e2af" FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding UsageSummary}" Foreground="#cdd6f4" FontSize="11"/>
                                                    <TextBlock Text="{Binding PercentText}" Foreground="#f9e2af" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UsedPercent}"
                                                             Background="#313244" Foreground="#f9e2af" BorderThickness="0" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Physical Disks -->
                            <TextBlock Text="Physical Storage Drives" Foreground="#a6adc8" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,6"/>
                            <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Model}" Foreground="#cdd6f4" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#f9e2af" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Interface}" Foreground="#6c7086" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="#a6e3a1" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Serial, StringFormat='S/N: {0}'}" Foreground="#6c7086" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- GPU & Display Section -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS &amp; DISPLAY (GPU)" Foreground="#cba6f7" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="#cdd6f4" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Vram, StringFormat='VRAM: {0}'}" Foreground="#cba6f7" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Resolution}" Foreground="#89b4fa" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DriverVersion, StringFormat='Driver: {0}'}" Foreground="#6c7086" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Network Adapters Section -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="NETWORK ADAPTERS &amp; INTERFACES" Foreground="#89dceb" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding NetworkAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1e1e2e" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#89dceb" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="#6c7086" FontSize="10"/>
                                                    <TextBlock Text="{Binding Speed}" Foreground="#a6adc8" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding Description}" Foreground="#cdd6f4" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding IPv4, StringFormat='IPv4: {0}'}" Foreground="#a6e3a1" FontSize="11"/>
                                                    <TextBlock Text="{Binding Gateways, StringFormat='Gateway: {0}'}" Foreground="#6c7086" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Mac, StringFormat='MAC: {0}'}" Foreground="#a6adc8" FontSize="10" FontFamily="Consolas"/>
                                                    <TextBlock Text="{Binding Dns, StringFormat='DNS: {0}'}" Foreground="#6c7086" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Dhcp, StringFormat='DHCP: {0}'}" Foreground="#6c7086" FontSize="10"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Active Processes (Task Manager) -->
                    <Border Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="ACTIVE PROCESSES" Foreground="#f38ba8" FontSize="13" FontWeight="Bold"/>
                                <Button Content="End Process" Click="EndProcessBtn_Click"
                                        Style="{StaticResource SidebarButton}" Padding="8,2" FontSize="11"
                                        Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>

                            <ListView x:Name="MonitorProcessList"
                                      ItemsSource="{Binding Processes}"
                                      Background="#1e1e2e" BorderThickness="0"
                                      Foreground="#cdd6f4" FontSize="11"
                                      MaxHeight="260"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                                        <GridViewColumn Header="Process Name" Width="240" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="CPU %" Width="90" DisplayMemberBinding="{Binding CpuPercent, StringFormat='{}{0:F1}%'}"/>
                                        <GridViewColumn Header="Memory (RAM)" Width="120" DisplayMemberBinding="{Binding RamMb, StringFormat='{}{0} MB'}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Placeholder (no session) -->
            <StackPanel x:Name="NoSessionPlaceholder"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No Active Session"
                           FontSize="24" Foreground="#6c7086" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a node from the sidebar to connect"
                           FontSize="13" Foreground="#45475a" HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
