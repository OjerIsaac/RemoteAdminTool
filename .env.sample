# ============================================================
# RemoteAdminTool - Environment Configuration Sample (.env.sample)
# ============================================================
# Copy this file to .env for local development.
# On Render, set these keys in the Environment tab.
# ============================================================

# ---- Relay Server ----
# RELAY_URL is used by build.ps1 to bake into Host.exe & Viewer.exe
RELAY_URL=wss://your-app-name.onrender.com/relay
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
RelayServer__Port=5050

# ---- Auth Tokens ----
# SuperAdminToken: Your master login token for Viewer.exe (leave License Key blank)
# HostToken: Global fallback token baked into Viewer.exe for /api/version checks
Auth__SuperAdminToken=replace_with_24_char_hex_secret
Auth__HostToken=replace_with_24_char_hex_secret

# ---- PostgreSQL ----
# On Render, DATABASE_URL is injected automatically when you link a Render Postgres DB.
# Locally, use the External Database URL from Render.
ConnectionStrings__Postgres=postgresql://user:password@host:5432/database_name

# ---- Local Dev Host Credentials (used by DevBuildHost.bat - updated by MakeDevHostKey.ps1) ----
DEV_LICENSE_KEY_HASH=
DEV_HOST_TOKEN=

# ---- Auto-Update Versions (bump before deploying a new build) ----
HOST_VERSION=1.0.0
VIEWER_VERSION=1.0.0

# ---- Auto-Update Download URLs (leave blank if not pushing an update) ----
HOST_DOWNLOAD_URL=
VIEWER_DOWNLOAD_URL=

# ---- Auto-Update EXE SHA-256 Hashes (printed by build scripts after publish) ----
HOST_EXE_SHA256=
VIEWER_EXE_SHA256=
